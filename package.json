{
  "name": "fitness-control",
  "version": "0.1.0",
  "description": "Control de mediciones y progreso de alumnas",
  "main": "./out/main/index.js",
  "author": "Jorge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
