{
  "name": "fitness-control",
  "version": "0.1.1",
  "description": "FitnessControl: control de mediciones y progreso de alumnos. Desarrollado por TADevStudio.",
  "main": "./out/main/index.js",
  "author": {
    "name": "TADevStudio"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "demo": "node scripts/cargar-demo.ts",
    "instalador": "npm run build && electron-builder --win --x64 --publish never",
    "release": "npm run build && node scripts/publicar.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "electron-winstaller@5.4.0": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jtapiaa22/FitnessControl.git"
  }
}
